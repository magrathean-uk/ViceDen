# ViceDen systemd env example.
# Copy this file to /etc/default/viceden, chmod 600, and edit the live copy.
# The package ships this template. The host owns the active env file.

RUST_LOG=viceden=debug,tower_http=info,sqlx=warn
VICEDEN_BOARDS_FILE=/opt/sites/viceden/runtime/current/config/boards.toml
VICEDEN_SERVER__BIND=127.0.0.1:8091
VICEDEN_SERVER__SECURE_COOKIES=true
VICEDEN_DATABASE__URL=postgres://viceden:change-me@127.0.0.1:5433/viceden
VICEDEN_DATABASE__REQUIRE_CONNECTION=true
VICEDEN_AUTH__FOUNDER_PASSWORD=replace-with-long-random-founder-password
VICEDEN_AUTH__TOKEN_PEPPER=replace-with-64-plus-char-random-pepper
VICEDEN_OPS__BACKUP_DIR=/opt/sites/viceden/backups

# AI moderation (M1+M2). Required in deploy mode.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Trusted-proxy CIDRs for real-client-IP extraction. Add Cloudflare ranges
# in deploy. Comma-separated.
VICEDEN_SERVER__PROXY__TRUSTED_CIDRS=127.0.0.1/32,::1/128
