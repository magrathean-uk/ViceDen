# Copy to /etc/viceden-deploy.env, chmod 600, owned by root.
# Use a fine-grained GitHub token only if the repo or release assets are private.

GITHUB_TOKEN=
GITHUB_REPOSITORY=magrathean-uk/ViceDen
RELEASE_TAG=deploy-main
DEPLOY_SCRIPT=/opt/sites/viceden/deploy.sh
DEPLOY_STATE_FILE=/opt/sites/viceden/runtime/last_release
RUNTIME_ASSET_NAME=viceden-linux-x86_64.tar.gz
CHECKSUM_ASSET_NAME=SHA256SUMS
