[Unit]
Description=ViceDen PostgreSQL Backup
After=postgresql@18-main.service
Requires=postgresql@18-main.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/viceden-postgres.env
ExecStart=/opt/sites/viceden/scripts/backup-postgres.sh
Environment=VICEDEN_POSTGRES_HOST=127.0.0.1
Environment=VICEDEN_POSTGRES_PORT=5433
SyslogIdentifier=viceden-backup
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/opt/sites/viceden/backups
